{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coregentis/MPLP-Protocol/release-manifests/mplp-public-manifest.schema.json",
  "title": "MPLP Protocol Public Manifest",
  "description": "Pointer-only public manifest exported by MPLP-Protocol for Website and Validation Lab consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "manifest_version",
    "generated_at",
    "protocol_name",
    "protocol_full_name",
    "protocol_version",
    "protocol_release_tag",
    "protocol_commit_sha",
    "copyright_holder",
    "trademark_notice",
    "license",
    "canonical_repository",
    "future_repository_target",
    "docs_url",
    "website_url",
    "schema_manifest",
    "sdk_packages",
    "pypi_packages",
    "validation_lab_pointer",
    "validation_lab_boundary",
    "website_boundary",
    "release_status",
    "forbidden_claims",
    "non_certification_notice",
    "package_replacement_status",
    "repo_migration_status"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "protocol_name": {
      "type": "string",
      "const": "MPLP"
    },
    "protocol_full_name": {
      "type": "string",
      "const": "Multi-Agent Lifecycle Protocol"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "protocol_release_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "copyright_holder": {
      "type": "string",
      "minLength": 1
    },
    "trademark_notice": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "const": "Apache-2.0"
    },
    "canonical_repository": {
      "type": "string",
      "format": "uri"
    },
    "future_repository_target": {
      "type": "string",
      "format": "uri"
    },
    "docs_url": {
      "type": "string",
      "format": "uri"
    },
    "website_url": {
      "type": "string",
      "format": "uri"
    },
    "schema_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_bundle_version",
        "invariant_bundle_version",
        "schema_manifest_path",
        "schema_manifest_url",
        "schema_manifest_commit_sha"
      ],
      "properties": {
        "schema_bundle_version": {
          "type": "string",
          "minLength": 1
        },
        "invariant_bundle_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "schema_manifest_url": {
          "type": "string",
          "format": "uri"
        },
        "schema_manifest_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "sdk_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "registry",
          "current_version",
          "next_clean_version",
          "package_replacement_status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "registry": {
            "type": "string",
            "const": "npm"
          },
          "current_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "next_clean_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "package_replacement_status": {
            "type": "string",
            "enum": [
              "planned_not_published",
              "published",
              "deferred",
              "skipped"
            ]
          }
        }
      }
    },
    "pypi_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "registry",
          "current_version",
          "next_clean_version",
          "package_replacement_status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "registry": {
            "type": "string",
            "const": "pypi"
          },
          "current_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "next_clean_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "package_replacement_status": {
            "type": "string",
            "enum": [
              "planned_not_published",
              "published",
              "deferred",
              "skipped"
            ]
          }
        }
      }
    },
    "validation_lab_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_lab_repo",
        "future_validation_lab_repo_target",
        "validation_lab_commit_sha",
        "validation_lab_release_tag",
        "consumed_protocol_manifest_id",
        "ruleset_version",
        "evidence_pack_version",
        "lab_url",
        "relation_status"
      ],
      "properties": {
        "validation_lab_repo": {
          "type": "string",
          "format": "uri"
        },
        "future_validation_lab_repo_target": {
          "type": "string",
          "format": "uri"
        },
        "validation_lab_commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "validation_lab_release_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "consumed_protocol_manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "ruleset_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_pack_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "lab_url": {
          "type": "string",
          "format": "uri"
        },
        "relation_status": {
          "type": "string",
          "enum": [
            "standalone_pointer_pending",
            "standalone_pointer_verified",
            "superseded"
          ]
        }
      }
    },
    "validation_lab_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_certifying",
        "non_normative",
        "evidence_based_verdicts_only",
        "no_endorsement",
        "no_certification",
        "no_regulator_approval",
        "no_protocol_truth_override",
        "no_runtime_authority",
        "no_sdk_authority"
      ],
      "properties": {
        "non_certifying": {
          "type": "boolean",
          "const": true
        },
        "non_normative": {
          "type": "boolean",
          "const": true
        },
        "evidence_based_verdicts_only": {
          "type": "boolean",
          "const": true
        },
        "no_endorsement": {
          "type": "boolean",
          "const": true
        },
        "no_certification": {
          "type": "boolean",
          "const": true
        },
        "no_regulator_approval": {
          "type": "boolean",
          "const": true
        },
        "no_protocol_truth_override": {
          "type": "boolean",
          "const": true
        },
        "no_runtime_authority": {
          "type": "boolean",
          "const": true
        },
        "no_sdk_authority": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "website_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_positioning_only",
        "seo_geo_surface",
        "protocol_truth_override_allowed",
        "schema_truth_override_allowed",
        "release_truth_override_allowed",
        "package_publication_authority_allowed"
      ],
      "properties": {
        "discovery_positioning_only": {
          "type": "boolean",
          "const": true
        },
        "seo_geo_surface": {
          "type": "boolean",
          "const": true
        },
        "protocol_truth_override_allowed": {
          "type": "boolean",
          "const": false
        },
        "schema_truth_override_allowed": {
          "type": "boolean",
          "const": false
        },
        "release_truth_override_allowed": {
          "type": "boolean",
          "const": false
        },
        "package_publication_authority_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "release_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "public_release_ready",
        "gates"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "candidate",
            "published",
            "superseded"
          ]
        },
        "public_release_ready": {
          "type": "boolean"
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_validated",
            "example_validated",
            "website_consumption_verified",
            "validation_lab_pointer_verified",
            "submodule_removal_allowed"
          ],
          "properties": {
            "schema_validated": {
              "type": "boolean"
            },
            "example_validated": {
              "type": "boolean"
            },
            "website_consumption_verified": {
              "type": "boolean"
            },
            "validation_lab_pointer_verified": {
              "type": "boolean"
            },
            "submodule_removal_allowed": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_certification_notice": {
      "type": "string",
      "minLength": 1
    },
    "package_replacement_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "clean_replacement_versions_defined",
        "package_actions_executed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned_not_published",
            "published",
            "deferred"
          ]
        },
        "clean_replacement_versions_defined": {
          "type": "boolean"
        },
        "package_actions_executed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "repo_migration_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_org",
        "future_org",
        "migration_now",
        "remotes_changed",
        "package_repository_urls_changed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "reserved_future_org_not_migrated"
        },
        "current_org": {
          "type": "string",
          "const": "Coregentis"
        },
        "future_org": {
          "type": "string",
          "const": "Multi-Agent-Lifecycle-Protocol"
        },
        "migration_now": {
          "type": "boolean",
          "const": false
        },
        "remotes_changed": {
          "type": "boolean",
          "const": false
        },
        "package_repository_urls_changed": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
