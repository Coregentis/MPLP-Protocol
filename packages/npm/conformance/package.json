{
  "name": "@mplp/conformance",
  "version": "1.0.1",
  "description": "Forward public package surface for MPLP conformance validation helpers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coregentis/MPLP-Protocol.git"
  },
  "keywords": [
    "mplp",
    "conformance",
    "validation",
    "testing",
    "golden-flows",
    "multi-agent",
    "protocol",
    "lifecycle",
    "conformance-tooling"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mplp/schema": "^1.0.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "author": "Jearon Wong",
  "copyright": "© 2026 Jearon Wong",
  "mplp": {
    "protocolVersion": "1.0.0",
    "frozen": true,
    "governance": "MPGC",
    "packageClass": "PUBLIC",
    "publishSurface": true,
    "publishScope": "public-npm",
    "packageRole": "conformance-forward-surface",
    "contractMode": "direct-conformance-facade"
  },
  "homepage": "https://www.mplp.io/what-is-mplp",
  "bugs": {
    "url": "https://github.com/Coregentis/MPLP-Protocol/issues"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
